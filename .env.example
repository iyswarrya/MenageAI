# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# --- SEC-01 Authentication ---
# Production: Firebase Authentication ID tokens
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional path to a service account JSON (otherwise Application Default Credentials):
# FIREBASE_CREDENTIALS_JSON=/path/to/firebase-service-account.json
# Never commit private keys.

# Local/demo only (fail closed on Cloud Run / production):
# APP_ENV=local
# ALLOW_INSECURE_IDENTITY=true
# Demo UI uses X-Menage-Dev-User: demo_user with household demo_household

# --- Twilio WhatsApp ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# Auth token used for the Messages API and for SEC-02A webhook signature checks.
# Required. Requests are rejected when this is missing. Never commit a real token.
# TWILIO_AUTH_TOKEN=your-auth-token
# Exact public HTTPS webhook URL configured in Twilio, including any query string.
# Required for SEC-02A. The signature is checked against this value, not Host or
# X-Forwarded-* headers. Example only — replace with the deployed webhook URL.
# TWILIO_WEBHOOK_PUBLIC_URL=https://your-service.example.com/twilio/webhook
# Comma-separated numbers for initial provisioning into household twilio_household:
# FAMILY_WHATSAPP_NUMBERS=whatsapp:+15551111111,whatsapp:+15552222222
# Runtime authz + receipt broadcast use active DB membership, not this env list.
# Revoked members (household_members.revoked_at set) are never re-added by startup provisioning.
# Optional cap for WhatsApp media downloads. Default is 10485760 (10 MB).
# Larger values are rejected. This is not a secret.
# TWILIO_MEDIA_MAX_BYTES=10485760
# SEC-02B downloads JPEG, PNG, and WebP. The first hop must be https://api.twilio.com.
# At most two redirects are followed, and only to api.twilio.com or mms.twiliocdn.com.
# PDF receipts are deferred.
